{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lostlight530.github.io/reflective-continuum/schemas/process-result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["accepted", "phase", "reflection_depth", "entropy_nats", "reasons"],
  "properties": {
    "accepted": {"type": "boolean"},
    "phase": {"enum": ["LIQUID", "GASEOUS"]},
    "reflection_depth": {"type": "integer", "minimum": 0, "maximum": 100},
    "entropy_nats": {"type": "number", "minimum": 0},
    "reasons": {"type": "array", "items": {"type": "string"}}
  }
}